      "id": "2110749749368488186",
      "public_metrics": {
        "bookmark_count": 0,
        "impression_count": 534,
        "like_count": 5,
        "quote_count": 0,
        "reply_count": 5,
        "retweet_count": 0
      },
      "text": "I’ve stopped asking which AI will win. Paying users spread about $66 a month across four tools, and every new agent is built for a different job. Here’s why I think AI will follow OTT, with two to four subscriptions each, and where I could be wrong. https://t.co/lrNf3ImLag",
      "url": "https://x.com/UtkarshLuthraX/status/2110749749368488186"
    },
    {
      "attachments": {
        "media_keys": [
          "13_2110669546478616576",
