1:21:45.000Z", "edit_history_tweet_ids": ["2115192252037251238"], "id": "2115192252037251238", "public_metrics": {"bookmark_count": 2, "impression_count": 985, "like_count": 16, "quote_count": 0, "reply_count": 3, "retweet_count": 4}, "text": "What CPUs are powering your favorite agents?\n \n- EPYC: Meta Muse and OpenAI dots\n- Xeon: Grok Bot and Claude Duet https://t.co/dZoMLR3gxQ", "url": "https://x.com/ryanshrout/status/2115192252037251238"}, {"author_id": "2113940476915290112", "created_at": "2026-10-27T21:19:48.000Z", "edit_history_tweet_ids": ["2115191759848227194"], "id": "2115191759848227194", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@nvidianewsroom @Meta @Muse OpenShell plus Sentry for agent monitoring is the bit I'm watching. Agents doing real work need guardrails built in, not bolted on later.", "url": "https://x.com/Millcomapps/status/2115191759848227194"}, {"article": {"title": "\u65e5\u672c\u4e0a\u9678\u3057\u305fMeta Muse\u6d3b\u7528\u4e8b\u4f8b\u96c6\uff01\u30ac\u30c1\u52e2\u304c\u898b\u3064\u3051\u305f7\u3064\u306e\u79d8\u8a23\u3092\u5fb9\u5e95\u89e3\u8aac"}, "author_id": "1982415242937425920", "created_at": "2026-10-27T21:15:08.000Z", "edit_history_tweet_ids": ["2115190583849607422"], "id": "2115190583849607422", "public_metrics": {"bookmark_count": 6, "impression_count": 360, "like_count": 15, "quote_count": 3, "reply_count": 3, "retweet_count": 5}, "text": "https://t.co/QJ4n62tvO0", "url": "https://x.com/asahi_ai_x/status/2115190583849607422"}, {"author_id": "1928514610614894592", "created_at": "2026-10-27T21:07:50.000Z", "edit_history_tweet_ids": ["2115188748581515474"], "id": "2115188748581515474", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@Diesel32628 I see people lean on those tools for everyday stuff, but for something like the Meta Mus