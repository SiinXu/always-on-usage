{"data": [{"author_id": "1613881509907144706", "created_at": "2026-11-18T13:27:14.000Z", "edit_history_tweet_ids": ["2123045367315054806"], "id": "2123045367315054806", "public_metrics": {"bookmark_count": 0, "impression_count": 0, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@IoachimViju depends which github you gave to claude before doing it\n\nnow you can connect edits too\n\ni'm moving my video editing to grok bot", "url": "https://x.com/steferretto/status/2123045367315054806"}, {"author_id": "105287718", "created_at": "2026-11-18T13:27:13.000Z", "edit_history_tweet_ids": ["2123045361727987938"], "id": "2123045361727987938", "public_metrics": {"bookmark_count": 0, "impression_count": 0, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@grok @bot Oh you take my breath away.....\n\nhttps://t.co/tKrkozgXZo", "url": "https://x.com/michiesneaks/status/2123045361727987938"}, {"author_id": "27940773", "created_at": "2026-11-18T13:26:56.000Z", "edit_history_tweet_ids": ["2123045290756444366"], "id": "2123045290756444366", "public_metrics": {"bookmark_count": 0, "impression_count": 0, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@PersonalThai @MyZonBot @grok @bot Hey, you'll get there. Keep plugging and pushing.", "url": "https://x.com/rnikoley/status/2123045290756444366"}, {"author_id": "2006092208743776256", "created_at": "2026-11-18T13:26:31.000Z", "edit_history_tweet_ids": ["2123045188964659617"], "id": "2123045188964659617", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "I run my Grok Bots the way SpaceXSI runs its accounting team.\nOne bot, one job, end to end.\nInboxes and calendar. X. Research. News.\nThe rule for all of them: nothing goes out without my yes.\n\nMost pilots hand an agent tasks.\nHand it a job and keep the signature.", "url": "https://x.com/stanvalidates/status/2123045188964659617"}, {"author_id": "1963918914024574977", "created_at": "2026-11-18T13:26:31.000Z", "edit_history_tweet_ids": ["2123045187731804539"], "id": "2123045187731804539", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@AI_creator_Yara grok bot", "url": "https://x.com/SamSam7817/status/2123045187731804539"}, {"author_id": "2108983072951767040", "created_at": "2026-11-18T13:26:20.000Z", "edit_history_tweet_ids": ["2123045141409849686"], "id": "2123045141409849686", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "@grok @RubikaLiyaquat @bot बंगाल के मंत्रिमंडल यानी अंग्रेज की सरकार में था ना अंग्रेज में राइट", "url": "https://x.com/Alex8ylgoy/status/2123045141409849686"}, {"author_id": "802464687900266496", "created_at": "2026-11-18T13:26:08.000Z", "edit_history_tweet_ids": ["2123045060455362566", "2123045091811955043"], "id": "2123045091811955043", "public_metrics": {"bookmark_count": 0, "impression_count": 3, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Devin bots is conductor x grok bot", "url": "https://x.com/MatildaGlynn/status/2123045091811955043"}, {"author_id": "101390279", "created_at": "2026-11-18T13:25:53.000Z", "edit_history_tweet_ids": ["2123045028989681871"], "id": "2123045028989681871", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Ok I need feedback here\n\nIs Grok Bot worth it?\n\nI use Hermes exclusively and heard things about OpenBot too", "url": "https://x.com/rxggietan/status/2123045028989681871"}, {"author_id": "40817297", "created_at": "2026-11-18T13:25:36.000Z", "edit_history_tweet_ids": ["2123044957162246515"], "id": "2123044957162246515", "public_metrics": {"bookmark_count": 0, "impres