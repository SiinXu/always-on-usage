": "https://x.com/VolrixAI/status/2115091610010853637"}, {"attachments": {"media_keys": ["3_2114797722171772930"]}, "author_id": "926343643304116224", "created_at": "2026-10-27T14:05:00.000Z", "edit_history_tweet_ids": ["2115082338246033888"], "id": "2115082338246033888", "public_metrics": {"bookmark_count": 0, "impression_count": 238, "like_count": 4, "quote_count": 0, "reply_count": 2, "retweet_count": 0}, "text": "Everyone's launching a personal AI agent.\n\nMeta Muse. Grok Bot. Instinct. ChatGPT Dots. Hark. And now Claude Duet.\n\nHere's what one actually is, explained simply.\n\nA personal agent is an assistant with its own computer, your logins, and permission to come to you first instead of https://t.co/HLwK7LJUHH", "url": "https://x.com/johnmatechAI/status/2115082338246033888"}], "includes": {"media": [{"media_key": "13_2115142400158863360", "preview_image_url": "https://pbs.twimg.com/amplify_video_thumb/2115142400158863360/img/ZM4UwXzKM_Jd6M-4.jpg", "type": "video"}, {"media_key": "3_2114797722171772930", "type": "photo", "url": "https://pbs.twimg.com/media/HVlFUtnakAIPyUo.png"}], "users": [{"id": "2113742860176461825", "name": "Atamansha", "profile_image_url": "https://pbs.twimg.com/profile_images/2114485494725664769/fYYopvq9_normal.jpg", "username": "AtamanshaX", "verified": false}, {"id": "2101757614082211840", "name": "AI Glitchez", "profile_image_url": "https://pbs.twimg.com/profile_images/2103906236890529793/IwG6yYZb_normal.jpg", "username": "aiglitchez", "verified": false}, {"id": "2036429515539488769", "name": "Volrix", "profile_image_url": "https://pbs.twimg.com/profile_images/2044829151098728448/OHbEFNtg_normal.jpg", "username": "VolrixAI", "verified": true}, {"id": "926343643304116224", "name": "John Ma | AI-native designer", "profile_image_url": "https://pbs.twimg.com/profile_images/1619781458893365248/MZVDEaIY_normal.jpg", "username": "johnmatechAI", "verified": false}]}, "meta": {"newest_id": "2115206126329274474", "next_token": "b26v89c19zqg8