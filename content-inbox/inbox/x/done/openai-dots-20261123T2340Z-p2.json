71"}, {"author_id": "69798551", "created_at": "2026-11-23T21:35:36.000Z", "edit_history_tweet_ids": ["2124980206377263511"], "id": "2124980206377263511", "in_reply_to_user_id": "384098551", "public_metrics": {"bookmark_count": 0, "impression_count": 8, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@_samirism Do Dots use Agents.MD by default?  What’s the best way to give my dot persistent rules?", "url": "https://x.com/kevoscott/status/2124980206377263511"}, {"attachments": {"media_keys": ["3_2124978571122720768"]}, "author_id": "2045850237806297088", "created_at": "2026-11-23T21:29:12.000Z", "edit_history_tweet_ids": ["2124978596397654482"], "id": "2124978596397654482", "in_reply_to_user_id": "1953337039510003712", "public_metrics": {"bookmark_count": 0, "impression_count": 35, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2124923055072043052", "type": "replied_to"}], "text": "@thsottiaux My dot went full retard for the last week or more. I deleted it and started over and the new one is just as bad. Only doing the same things I have done since launch with no issues..... https://t.co/RYm2qqBmXd", "url": "https://x.com/TheVibingDev/status/2124978596397654482"}, {"attachments": {"media_keys": ["3_2124978100345655298", "3_2124978100345675776", "3_2124978100324696064"]}, "author_id": "20904050", "created_at": "2026-11-23T21:27:15.000Z", "edit_history_tweet_ids": ["2124978105160716331"], "id": "2124978105160716331", "public_metrics": {"bookmark_count": 8, "impression_count": 6735, "like_count": 64, "quote_count": 1, "reply_count": 10, "retweet_count": 4}, "text": "ChatGPT Dots rolling out in Europe, for real this time...? \n\nMine is fully functional at last! https://t.co/K0MCrHaUY7", "url": "https://x.com/viticci/status/2124978105160716331"}, {"author_id": "2022731739647381505", "created_at": "2026-11-23T21:20:05.000Z", "edit_history_tweet_ids": ["2124976305208984055"], "id": "