473954877440", "public_metrics": {"bookmark_count": 0, "impression_count": 113, "like_count": 3, "quote_count": 0, "reply_count": 1, "retweet_count": 1}, "referenced_tweets": [{"id": "2124973860970021052", "type": "replied_to"}], "text": "@TekonBurns For those out there comparing Grok Bot VS ChatGPT Dots - here is a simple feature checklist. 🙃 👇 https://t.co/urJKqbIMiy", "url": "https://x.com/lwytch/status/2124974281201209416"}, {"author_id": "56194292", "created_at": "2026-11-23T21:10:50.000Z", "edit_history_tweet_ids": ["2124973975692620226"], "id": "2124973975692620226", "in_reply_to_user_id": "14069848", "public_metrics": {"bookmark_count": 0, "impression_count": 21, "like_count": 1, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "referenced_tweets": [{"id": "2124973481926287621", "type": "replied_to"}], "text": "@koltregaskes Mine is working as well, but I was in the US when they were released, so I created my Dot there.", "url": "https://x.com/jonathanroomer/status/2124973975692620226"}, {"author_id": "1864897473954877440", "created_at": "2026-11-23T21:10:23.000Z", "edit_history_tweet_ids": ["2124973860970021052"], "id": "2124973860970021052", "public_metrics": {"bookmark_count": 2, "impression_count": 2160, "like_count": 49, "quote_count": 0, "reply_count": 10, "retweet_count": 6}, "text": "🚨ChatGPT Dots and the redesigned mobile app just landed in Europe and the UK!!!", "url": "https://x.com/TekonBurns/status/2124973860970021052"}, {"author_id": "1901580990", "created_at": "2026-11-23T21:05:39.000Z", "edit_history_tweet_ids": ["2124972669045186881"], "id": "2124972669045186881", "public_metrics": {"bookmark_count": 0, "impression_count": 85, "like_count": 2, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "referenced_tweets": [{"id": "2124955668989845710", "type": "quoted"}], "text": "Same here in Czechia, my Dot Botter is live without VPN. \n\nHopefully not just another bug https://t.co/VrWwGt6ixP", "url": "https://x.com/andrewxix/status/2124972669045186881"}, {"attachments": {"media_keys": ["3_2124971776799039488"]}, "author_id": "1769390151283757057", "created_at": "2026-11-23T21:02:09.000Z", "edit_history_tweet_ids": ["2124971790564733295"], "id": "2124971790564733295", "public_metrics": {"bookmark_count": 0, "impression_count": 34, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "I've #chatgpt #dots in Italy, EU https://t.co/1buD0kpxwD", "url": "https://x.com/JustTAnuzzo/status/2124971790564733295"}, {"author_id": "1556991329300799496", "created_at": "2026-11-23T20:51:18.000Z", "edit_history_tweet_ids": ["2124969061322817554"], "id": "2124969061322817554", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": ".@thsottiaux I'm in the UK and my Dot just appeared in my Mac and phone app. Was that supposed to happen?", "url": "https://x.com/fishtea0/status/2124969061322817554"}, {"attachments": {"media_keys": ["3_2124968148491235329"]}, "author_id": "476749129", "created_at": "2026-11-23T20:50:37.000Z", "edit_history_tweet_ids": ["2124968886550589456"], "id": "2124968886550589456", "public_metrics": {"bookmark_count": 1, "impression_count": 157, "like_count": 3, "quote_count": 0, "reply_count": 2, "retweet_count": 0}, "text": "ChatGPT Dots just showed up for me in Germany, no VPN. OpenAI docs still say it's not available in the EU. Is this another accident, or are we finally getting access in the EU? https://t.co/xyr3DtAHqs", "url": "https://x.com/vladimirsiedykh/status/2124968886550589456"}, {"author_id": "1129880257220235264", "created_at": "2026-11-23T20:49:35.000Z", "edit_history_tweet_ids": ["2124968629091623214"], "id": "2124968629091623214", "public_metrics": {"bookmark_count": 0, "impression_count": 406, "like_count": 5, "quote_count": 0, "reply_count": 2, "retweet_count": 0}, "text": "seems like chatgpt dots is finally enabled in EU, anyone used it and think it's useful? what are good use cases?", "url": "https://x.com/j0wimo/status/2124968629091623214"}, {"attachments": {"media_keys": ["3_2124966539170377728", "3_2124966539145224192", "3_2124966539250085889", "3_2124966539128369152", "3_2124966539220619264"]}, "author_id": "3980735590", "created_at": "2026-11-23T20:41:19.000Z", "edit_history_tweet_ids": ["2124966546087043498"], "id": "2124966546087043498", "public_metrics": {"bookmark_count": 48, "impression_count": 13746, "like_count": 261, "quote_count": 2, "reply_count": 12, "retweet_count": 8}, "text": "I’ve got a new UI design on ChatGPT and now my Dot is available there as well (in the EU). \n\nIt seems like GPT 6.2 Sol rollout was in fact bigger than we thought. \n\nI hope it will stay there this time 😅 https://t.co/vbz3AJCQ64", "url": "https://x.com/testingcatalog/status/2124966546087043498"}, {"author_id": "75008467", "created_at": "2026-11-23T20:40:53.000Z", "edit_history_tweet_ids": ["2124966436959564261"], "id": "2124966436959564261", "in_reply_to_user_id": "1633874951508721686", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2124944225955639430", "type": "replied_to"}], "text": "@OpenAIDevs All of this and I still can't get a widget on my Android phone to go directly to my DOT", "url": "https://x.com/peconicgp/status/2124966436959564261"}, {"attachments": {"media_keys": ["3_2124965560941514752"]}, "author_id": "1794290061376454656", "created_at": "2026-11-23T20:39:43.000Z", "edit_history_tweet_ids": ["2124966144792817801"], "id": "2124966144792817801", "public_metrics": {"bookmark_count": 0, "impression_count": 40, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Really loving @ChatGPT Dots + Spaces 🫡\n\nFking Amazing - made my productivity 2x and even on plus plan the limits are very very generous for me\n\nThough I'm afraid, the limits are generous only till the limit merge will come to chatgpt 🥲 https://t.co/FQKPMb8Adg", "url": "https://x.com/AkshajRawa91105/status/2124966144792817801"}, {"author_id": "27956050", "created_at": "2026-11-23T20:25:04.000Z", "edit_history_tweet_ids": ["2124962459597537773"], "id": "2124962459597537773", "in_reply_to_user_id": "1953337039510003712", "public_metrics": {"bookmark_count": 0, "impression_count": 72, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2124923055072043052", "type": "replied_to"}], "text": "@thsottiaux Ultrafast for my dot when? imo background work can be standard speed, but when I'm actively engaged in the conversation with it by typing and waiting for a response it's just too slow for me to pick it over 6.2 sol high ultrafast", "url": "https://x.com/Chris_Falck/status/2124962459597537773"}, {"author_id": "1172026590726897664", "created_at": "2026-11-23T20:24:40.000Z", "edit_history_tweet_ids": ["2124962356707086533"], "id": "2124962356707086533", "public_metrics": {"bookmark_count": 0, "impression_count": 47, "like_count": 0, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "Dots finally out for EU Pro users? I suddenly got a notification of my dot messaging me on my phone.", "url": "https://x.com/Caspar___/status/2124962356707086533"}, {"author_id": "1493751380938420227", "created_at": "2026-11-23T20:18:51.000Z", "edit_history_tweet_ids": ["2124960894958682427"], "id": "2124960894958682427", "in_reply_to_user_id": "1953337039510003712", "public_metrics": {"bookmark_count": 0, "impression_count": 7, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2124923055072043052", "type": "replied_to"}], "text": "@thsottiaux Another one, My Dot flagged an email about 30 minutes after I already responded to that email. Speed please.", "url": "https://x.com/muncusagruncus/status/2124960894958682427"}, {"author_id": "1152337093", "created_at": "2026-11-23T20