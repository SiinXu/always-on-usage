}, "author_id": "1666103476945031168", "created_at": "2026-10-22T18:52:25.000Z", "edit_history_tweet_ids": ["2113342731598876858"], "id": "2113342731598876858", "public_metrics": {"bookmark_count": 9, "impression_count": 4412, "like_count": 22, "quote_count": 3, "reply_count": 3, "retweet_count": 6}, "text": "https://t.co/V2QflQO8Z6", "url": "https://x.com/rryssf/status/2113342731598876858"}, {"article": {"title": "高盛Goldman Sachs 宣布再投 5 亿美元，帮企业主补AI课"}, "author_id": "1239798804800344064", "created_at": "2026-10-22T18:37:15.000Z", "edit_history_tweet_ids": ["2113338911661650133"], "id": "2113338911661650133", "public_metrics": {"bookmark_count": 0, "impression_count": 309, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "https://t.co/HvHveovurP", "url": "https://x.com/JoyceZh94122377/status/2113338911661650133"}, {"author_id": "374239974", "created_at": "2026-10-22T17:36:57.000Z", "edit_history_tweet_ids": ["2113323736279732414"], "id": "2113323736279732414", "public_metrics": {"bookmark_count": 0, "impression_count": 118, "like_count": 1, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "Tried to have my @OpenAI Dot build some stuff and it used up an insane amount of tokens, kept randomly stopping, did not help me achieve my goals. Downgraded my subscription. \n\n@Meta @Muse has been working on the same task, is proactive, and continues to get stuff done for me.", "url": "https://x.com/JackStrawFM/status/2113323736279732414"}, {"article": {"title": "Daily AI Frontier News · October 22, 2026"}, "author_id": "2043685830758219776", "created_at": "2026-10-22T17:05:45.000Z", "edit_history_tweet_ids": ["2113315887377789141"], "id": "2113315887377789141", "public_metrics": {"bookmark_count": 0, "impression_count": 296, "like_count": 2, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Today's AI frontier news: 13 top stories, Anthropic's proactive Claude Duet, Hassabis pulls AGI timeline to 2–3 years, NVIDIA