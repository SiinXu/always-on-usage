weet_count": 0}, "referenced_tweets": [{"id": "2118601700697391385", "type": "replied_to"}], "text": "@juberti (iphone) If my dot could press that phone button when I tell her to \"call me\", it would be incredible.", "url": "https://x.com/realdev_notabot/status/2118684850165072278"}, {"author_id": "1274019067750465538", "created_at": "2026-11-06T12:37:30.000Z", "edit_history_tweet_ids": ["2118684196181037412"], "id": "2118684196181037412", "in_reply_to_user_id": "2049491619926401024", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118322207382512080", "type": "replied_to"}], "text": "@FanNia4848 My dot", "url": "https://x.com/MT82376431/status/2118684196181037412"}, {"author_id": "2014412560888373248", "created_at": "2026-11-06T12:33:22.000Z", "edit_history_tweet_ids": ["2118683155662266495"], "id": "2118683155662266495", "public_metrics": {"bookmark_count": 0, "impression_count": 19, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118679288794735026", "type": "quoted"}], "text": "I threw a giant bag of dog food at a Petco employee because she yelled at me to stand on my dot. Refused to wear a mask. Became a person. https://t.co/AJtfeStDV4", "url": "https://x.com/Mothershipton40/status/2118683155662266495"}, {"author_id": "1939059228779417600", "created_at": "2026-11-06T12:07:21.000Z", "edit_history_tweet_ids": ["2118676608538034252"], "id": "2118676608538034252", "in_reply_to_user_id": "1999197246991314944", "public_metrics": {"bookmark_count": 0, "impression_count": 14, "like_count": 0, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "referenced_tweets": [{"id": "2118661282119500151", "type": "replied_to"}], "text": "@xoaanya @rxhit05 Dot is incredible, my dot uses my Opus 5.5 All the time🤷.", "url": "https://x.com/Mr_BereaN/status/2118676608538034252"}, {"author_id": "2108819820770975745", "created_at": "2026-11-06T12:00:01.000Z", "edit_history_tweet_ids": ["2118674764709740996"], "id": "2118674764709740996", "public_metrics": {"bookmark_count": 3, "impression_count": 103, "like_count": 5, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Can AI help you research a stock? Or get you misled?\n\nWe asked Grok Bot @bot, ChatGPT dots @dots, Muse @Muse and Instinct @instinct to check a viral claim: Delta revenue down 68%. Nothing attached. Open what each said before you act.\n\nSee how each did:\nhttps://t.co/ZwAeWJQeOy", "url": "https://x.com/AnalystAIlab/status/2118674764709740996"}, {"author_id": "2118339342934401024", "created_at": "2026-11-06T11:39:06.000Z", "edit_history_tweet_ids": ["2118669499335623138"], "id": "2118669499335623138", "in_reply_to_user_id": "384098551", "public_metrics": {"bookmark_count": 0, "impression_count": 0, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118103057980690771", "type": "replied_to"}], "text": "@_samirism Samir please give me a way to call my dot from CarPlay/Android Auto, would be a huge QoL Upgrade", "url": "https://x.com/gavinswarmforge/status/2118669499335623138"}, {"author_id": "61243731", "created_at": "2026-11-06T11:31:10.000Z", "edit_history_tweet_ids": ["2118667505514295296"], "id": "2118667505514295296", "in_reply_to_user_id": "1319857338958942209", "public_metrics": {"bookmark_count": 0, "impression_count": 7, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118558304872042519", "type": "replied_to"}], "text": "@danialhasan I wanna like dots but still find a codex thread better than my dot", "url": "https://x.com/MikeWigmore/status/2118667505514295296"}, {"author_id": "195844881", "created_at": "2026-11-06T11:29:58.000Z", "edit_history_tweet_ids": ["2118667200437338557"], "id": "2118667200437338557", "in_reply_to_user_id": "97479882", "public_metrics": {"bookmark_count": 0, "impression_count": 0, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118663218684125649", "type": "replied_to"}], "text": "@ShawnCT_ Watching the housing market explode while realizing your thousand ancestors left you nothing is painful, making my $dot portfolio look incredibly safe. 🏠", "url": "https://x.com/guero1988/status/2118667200437338557"}, {"author_id": "43564329", "created_at": "2026-11-06T11:24:01.000Z", "edit_history_tweet_ids": ["2118665705101177136"], "id": "2118665705101177136", "in_reply_to_user_id": "384098551", "public_metrics": {"bookmark_count": 0, "impression_count": 4, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118410662389129475", "type": "replied_to"}], "text": "@_samirism @TokenGremlin I like my dot BUT there is sooooo many possibility to improve them..... and my ideas come from own brain - so if you are open to hear / read them just contact me :-)", "url": "https://x.com/advertester/status/2118665705101177136"}, {"attachments": {"media_keys": ["13_2118665341660188672"]}, "author_id": "796704957047209984", "created_at": "2026-11-06T11:23:04.000Z", "edit_history_tweet_ids": ["2118665466835030416"], "id": "2118665466835030416", "public_metrics": {"bookmark_count": 1, "impression_count": 272, "like_count": 7, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "Performance test. So far so good. 3000 units moving and visible at once. Trees, grass, water present. 95+ FPS on Steam Machine in 4K full detail, 80+ FPS on Steam Deck, 800p full detail.\n\n#gamedev #indiegame #unity #dots #ecs #lowres #ps1 #pixelart #towerdefense https://t.co/VIie88rStl", "url": "https://x.com/Grumpy_Bull_G/status/2118665466835030416"}, {"attachments": {"media_keys": ["3_2118665108876562434"]}, "author_id": "1032002245", "created_at": "2026-11-06T11:21:41.000Z", "edit_history_tweet_ids": ["2118665117101355271"], "id": "2118665