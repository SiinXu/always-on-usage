2121703093024997535"}, {"author_id": "1877825053251039232", "created_at": "2026-11-14T20:19:24.000Z", "edit_history_tweet_ids": ["2121699539178430899"], "id": "2121699539178430899", "public_metrics": {"bookmark_count": 0, "impression_count": 7, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Muse is by far the most generous personal agent right now. Its free plan gets 100M tokens a week, and the Power plan gets 500M for $16/month. Refer a friend and you each get 1B bonus tokens, for up to 20 friends. Many users on X say they rarely, if ever, reach their usage limit", "url": "https://x.com/AINewsDeskHQ/status/2121699539178430899"}, {"author_id": "2102579058077032448", "created_at": "2026-11-14T20:17:44.000Z", "edit_history_tweet_ids": ["2121699123439219094"], "id": "2121699123439219094", "in_reply_to_user_id": "384098551", "public_metrics": {"bookmark_count": 0, "impression_count": 125, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2121698297501175962", "type": "replied_to"}], "text": "@_samirism I made a pet and made that my dot. Pretty cool, I'm looking forward to having multiple dots.", "url": "https://x.com/NDlvqu2/status/2121699123439219094"}, {"attachments": {"media_keys": ["3_2121698751375187968"]}, "author_id": "240193355", "created_at": "2026-11-14T20:16:16.000Z", "edit_history_tweet_ids": ["2121698753770066054"], "id": "2121698753770066054", "in_reply_to_user_id": "384098551", "public_metrics": {"bookmark_count": 0, "impression_count": 147, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2121698297501175962", "type": "replied_to"}], "text": "@_samirism All of them.\nThis is my Dot. https://t.co/uhWBSVVmYc", "url": "https://x.com/KristophJeffers/status/2121698753770066054"}, {"author_id": "1566765956600582145", "created_at": "2026-11-14T20:10:50.000Z", "edit_history_tweet_ids": ["2121697383751004498"], "id": "21